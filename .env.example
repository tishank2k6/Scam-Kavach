# ==============================================================================
# ScamShield AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or backend/.env) to configure settings.
# Notice: ScamShield AI is 100% functional out of the box with zero paid API keys!
# ==============================================================================

# Core Service Settings
PROJECT_NAME="ScamShield AI"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=False

# Database Configuration
# Default: SQLite zero-configuration database (works immediately anywhere)
# Production: postgresql://user:password@localhost:5432/scamshield
DATABASE_URL="sqlite:///./scamshield.db"

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=40
MAX_TEXT_LENGTH=30000

# ------------------------------------------------------------------------------
# Optional AI / LLM Configuration (Provider-Agnostic)
# ------------------------------------------------------------------------------
# Leave as "none" to use ScamShield's built-in deterministic explainability engine.
# Supported providers: "none", "openai", "gemini", "groq"
LLM_PROVIDER="none"
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# Optional Threat Intelligence APIs
# ------------------------------------------------------------------------------
# If omitted, ScamShield safely applies structural heuristics and flags "unlisted".
SAFE_BROWSING_API_KEY=""
VIRUSTOTAL_API_KEY=""

# ------------------------------------------------------------------------------
# Frontend Environment
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
