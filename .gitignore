# ==============================================================================
# Scam Kavach - Root Git Ignore Configuration
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python virtual environment & caches
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.pytest_cache/
.coverage
htmlcov/

# Local runtime databases & SQLite files
*.db
*.sqlite
*.sqlite3

# Next.js build output & caches
.next/
out/
build/
dist/
.vercel
*.tsbuildinfo

# Environment variables & secrets (Explicitly allow .env.example)
.env
.env*.local
backend/.env
frontend/.env
frontend/.env*.local
*.pem
*.key
*.cert

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and IDE caches
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
